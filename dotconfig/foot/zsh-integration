function pipe-output-precmd {
    if ! builtin zle; then
        print -n "\e]133;D\e\\"
    fi
}

add-zsh-hook -Uz precmd pipe-output-precmd

function pipe-output-preexec {
    print -n "\e]133;C\e\\"
}

add-zsh-hook -Uz preexec pipe-output-preexec

# Foot open new instance in current working directory
function osc7-pwd() {
    emulate -L zsh # also sets localoptions for us
    setopt extendedglob
    local LC_ALL=C
    printf '\e]7;file://%s%s\e\' $HOST ${PWD//(#m)([^@-Za-z&-;_~])/%${(l:2::0:)$(([##16]#MATCH))}}
}

function chpwd-osc7-pwd() {
    (( ZSH_SUBSHELL )) || osc7-pwd
}
add-zsh-hook -Uz chpwd chpwd-osc7-pwd
